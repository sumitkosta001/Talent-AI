# Root Level Environment Configurations for Docker Compose
PROJECT_NAME=TalentAI
ENVIRONMENT=development

# Postgres Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_secure
POSTGRES_DB=talentai

# Redis Config
REDIS_PASSWORD=redis_password_secure

# RabbitMQ Config
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=rabbitmq_password_secure

# MinIO Config
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_secure
