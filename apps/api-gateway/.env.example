# ==============================================================================
# TalentAI API Gateway Environment Configuration Template
# Copy this file to .env or .env.development / .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_NAME=TalentAI API Gateway
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change_this_to_a_secure_64_character_random_string_in_production
TIMEZONE=UTC
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
ALLOWED_HOSTS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=talentai
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password_secure
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_secure@localhost:5432/talentai

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_secure
REDIS_URL=redis://:redis_password_secure@localhost:6379/0

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# OAUTH PROVIDERS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GITHUB_CLIENT_ID=your_github_client_id_placeholder
GITHUB_CLIENT_SECRET=your_github_client_secret_placeholder
LINKEDIN_CLIENT_ID=your_linkedin_client_id_placeholder
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_placeholder

# ------------------------------------------------------------------------------
# EMAIL (Resend / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_placeholder
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_placeholder
EMAIL_FROM=TalentAI <no-reply@talentai.com>

# ------------------------------------------------------------------------------
# CLOUDINARY STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_placeholder
CLOUDINARY_API_KEY=your_cloudinary_api_key_placeholder
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_placeholder

# ------------------------------------------------------------------------------
# AI & ML INTEGRATIONS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_placeholder
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_placeholder
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_placeholder

# ------------------------------------------------------------------------------
# MONITORING & ERROR TRACING
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_placeholder@sentry.io/project_id

# ------------------------------------------------------------------------------
# CELERY TASK BROKER & BACKEND
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:redis_password_secure@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password_secure@localhost:6379/2

# ------------------------------------------------------------------------------
# OCR (Tesseract) — Day 22 Scanned PDF Processing
# ------------------------------------------------------------------------------
# Path to Tesseract executable. Leave empty to use system PATH.
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_RENDER_DPI=300
OCR_MIN_TEXT_CHARS_PER_PAGE=30
OCR_PSM=6
OCR_UPSCALE_FACTOR=2.0
OCR_THRESHOLD_VALUE=180

# ------------------------------------------------------------------------------
# NLP & SPA CY — Day 24 Resume Skills Extraction
# ------------------------------------------------------------------------------
SPACY_MODEL=en_core_web_sm
SKILL_MATCH_CASE_INSENSITIVE=true
SKILL_MIN_CONFIDENCE=0.5

# ------------------------------------------------------------------------------
# FAISS Vector Indexing — Day 32 Vector Search
# ------------------------------------------------------------------------------
FAISS_INDEX_DIR=data/faiss
FAISS_RESUME_INDEX_NAME=resumes.index
FAISS_JOB_INDEX_NAME=jobs.index
FAISS_EMBEDDING_DIMENSION=384
FAISS_INDEX_TYPE=FLAT_IP
FAISS_TOP_K=10

# ------------------------------------------------------------------------------
# Recommendation Engine — Day 33 Recommendations
# ------------------------------------------------------------------------------
RECOMMENDATION_SEMANTIC_WEIGHT=0.50
RECOMMENDATION_ATS_WEIGHT=0.50
RECOMMENDATION_DEFAULT_TOP_K=10
RECOMMENDATION_MAX_TOP_K=50
RECOMMENDATION_POOL_FACTOR=3

# ------------------------------------------------------------------------------
# Interview Question Generator — Day 34 AI Interview Questions
# ------------------------------------------------------------------------------
INTERVIEW_QUESTION_DEFAULT_COUNT=10
INTERVIEW_QUESTION_MAX_COUNT=50
INTERVIEW_QUESTION_DEFAULT_DIFFICULTY=MEDIUM
INTERVIEW_QUESTION_DEFAULT_PROVIDER=auto



